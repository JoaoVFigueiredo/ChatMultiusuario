# Groq e priorizado quando GROQ_API_KEY estiver configurada.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Alternativa: token fine-grained Hugging Face com permissao Inference Providers.
ASSISTENTE_IA_TOKEN=
# Confirme no catalogo de Inference Providers qual modelo esta disponivel na sua conta
ASSISTENTE_IA_MODEL=meta-llama/Llama-3.1-8B-Instruct:featherless-ai
# Opcional: token Hugging Face da Bola, usado quando GROQ_API_KEY estiver vazio
BOLA_TOKEN=
BOLA_MODEL=Qwen/Qwen2.5-1.5B-Instruct:featherless-ai
